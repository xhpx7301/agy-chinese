      "replacement": "技能列表 ($1)"
    },
    {
      "pattern": "^Rules (\\d+)$",
      "replacement": "规则列表 ($1)"
    },
    {
      "pattern": "^Plugins (\\d+)$",
      "replacement": "插件列表 ($1)"
    },
    {
      "pattern": "^(\\d+)m ago$",
      "replacement": "$1 分钟前"
    },
    {
      "pattern": "^(\\d+)h ago$",
      "replacement": "$1 小时前"
    },
    {
      "pattern": "^(\\d+)d ago$",
      "replacement": "$1 天前"
    },
    {
      "pattern": "^(.+?) Weekly Limit$",
      "replacement": "$1 每周额度"
    },
    {
      "pattern": "^(.+?) 5-Hour Limit$",
      "replacement": "$1 5 小时额度"
    },
    {
      "pattern": "^(\\d+\\s*days?(?:,\\s*\\d+\\s*hours?)?|\\d+\\s*hours?(?:,\\s*\\d+\\s*minutes?)?|\\d+\\s*minutes?(?:,\\s*\\d+\\s*seconds?)?)$",
      "replacement": "$1"
    },
    {
      "pattern": "^(.+?) that may offload routine steps to (.+?)\\. Same (.+?)-level quality, fewer tokens used\\.$",
      "replacement": "$1 模型，可将常规步骤分流至 $2 处理。保持同等 $3 级质量，同时消耗更少 Token。"
    },
    {
      "pattern": "^(.+?) will be removed from Antigravity on (.+?)\\.$",
      "replacement": "$1 将于 $2 从 Antigravity 中移除。"
    },
    {
