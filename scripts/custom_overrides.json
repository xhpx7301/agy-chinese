  "regex_rules": [
    {
      "pattern": "^Permanently delete\\s+(.*?)\\s+including\\s+(\\d+)\\s+active\\s+conversations?$",
      "replacement": "永久删除 $1，包括其中的 $2 个活跃会话"
    },
    {
      "pattern": "^Permanently delete\\s+(.*?)\\s+including\\s+(\\d+)\\s+conversations?\\.?$",
      "replacement": "永久删除 $1，包括其中的 $2 个会话"
    },
    {
      "pattern": "^(\\d+)\\s+active\\s+conversations?$",
      "replacement": "$1 个活跃会话"
    },
    {
      "pattern": "^(>\\s*)?(\\d+)\\s+tools?\\s+enabled$",
      "replacement": "$1已启用 $2 个工具"
    },
    {
      "pattern": "^You have used some of your 5-hour limit, it will fully refresh in (.*)\\.$",
      "replacement": "您已使用部分 5 小时限额，将在 $1 后完全刷新恢复。"
    },
    {
      "pattern": "^You have used some of your weekly limit, it will fully refresh in (.*)\\.$",
      "replacement": "您已使用部分每周限额，将在 $1 后完全刷新恢复。"
    },
    {
      "pattern": "^(\\d+)\\s+files?,\\s*(\\d+)\\s+search(?:es)?$",
      "replacement": "$1 个文件，$2 次搜索"
    },
    {
      "pattern": "^Ran (\\d+) commands?\\.?\\s*Working$",
      "replacement": "已执行 $1 条命令，正在处理中"
    },
    {
      "pattern": "^(Rules|Skills|Mcp Tools):\\s*([\\d,]+)\\s*tokens$",
      "replacement": "$1: $2 tokens (提示词占用)"
    },
    {
      "pattern": "^Send feedback as (.*)$",
      "replacement": "以账号 $1 发送反馈"
    },
    {
      "pattern": "^Plugin:\\s*(.*)$",
      "replacement": "插件: $1"
    },
    {
      "pattern": "^Show (\\d+) breakdown(s?)$",
      "replacement": "查看 $1 项明细"
    },
    {
      "pattern": "^See all \\((\\d+)\\)$",
      "replacement": "查看全部 ($1)"
    },
    {
      "pattern": "^(\\d+(?:\\.\\d+)?)% of the customization budget is available\\.$",
      "replacement": "$1% 的自定义扩展配额可用。"
    },
    {
      "pattern": "^(\\d+) agent(s?) running$",
      "replacement": "$1 个智能体正在运行"
    },
    {
      "pattern": "^No more older messages, showing (\\d+) of (\\d+)$",
      "replacement": "已显示全部历史消息 (共 $2 条)"
    },
    {
      "pattern": "^Load older messages, showing (\\d+) of (\\d+)$",
      "replacement": "加载更早历史消息 (当前 $1 / 共 $2 条)"
    },
    {
      "pattern": "^Select model, current: (.*)$",
      "replacement": "选择模型，当前: $1"
    },
    {
      "pattern": "^Worked for (.*)$",
      "replacement": "耗时 $1"
    },
    {
      "pattern": "^Thought for (.*)$",
      "replacement": "思考用时 $1"
    },
    {
      "pattern": "^Exploring (\\d+) files?, (\\d+) folders?$",
      "replacement": "正在检索 $1 个文件，$2 个文件夹"
    },
    {
      "pattern": "^(\\d+) files? changed$",
      "replacement": "$1 个文件已修改"
    },
    {
      "pattern": "^(\\d+) file(s?)$",
      "replacement": "$1 个文件"
    },
    {
      "pattern": "^(\\d+) command(s?)$",
      "replacement": "$1 条命令"
    },
    {
